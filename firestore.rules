rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isOwner(uid) {
      return isVerifiedUser() && request.auth.uid == uid;
    }

    function isValidUserVaultProfile(data, userId) {
      return data.keys().hasAll(['uid', 'email', 'displayName', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['uid', 'email', 'displayName', 'createdAt', 'updatedAt'])
        && data.uid is string
        && isValidId(data.uid)
        && data.uid == userId
        && data.uid == request.auth.uid
        && data.email is string
        && data.email.size() >= 3
        && data.email.size() <= 254
        && data.displayName is string
        && data.displayName.size() >= 1
        && data.displayName.size() <= 100
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidReceipt(data, receiptId) {
      return data.keys().hasAll([
          'id', 'userId', 'sha256Hash', 'uploadedAtUtc', 'fileName',
          'fileSizeBytes', 'mimeType', 'imageUrl', 'merchant_name',
          'receipt_date', 'currency', 'subtotal', 'gst_amount',
          'total_amount', 'category', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'id', 'userId', 'sha256Hash', 'uploadedAtUtc', 'fileName',
          'fileSizeBytes', 'mimeType', 'imageUrl', 'merchant_name',
          'receipt_date', 'currency', 'subtotal', 'gst_amount',
          'total_amount', 'category', 'createdAt', 'updatedAt'
        ])
        && data.id is string
        && isValidId(data.id)
        && data.id == receiptId
        && data.userId is string
        && isValidId(data.userId)
        && data.userId == request.auth.uid
        && data.sha256Hash is string
        && data.sha256Hash.size() == 64
        && data.sha256Hash.matches('^[a-f0-9]{64}$')
        && data.uploadedAtUtc is string
        && data.uploadedAtUtc.size() >= 10
        && data.uploadedAtUtc.size() <= 40
        && data.fileName is string
        && data.fileName.size() >= 1
        && data.fileName.size() <= 255
        && data.fileSizeBytes is number
        && data.fileSizeBytes > 0
        && data.fileSizeBytes <= 20000000
        && data.mimeType is string
        && data.mimeType.size() >= 5
        && data.mimeType.size() <= 64
        && data.imageUrl is string
        && data.imageUrl.size() >= 1
        && data.imageUrl.size() <= 1024
        && data.merchant_name is string
        && data.merchant_name.size() >= 1
        && data.merchant_name.size() <= 140
        && data.receipt_date is string
        && data.receipt_date.size() == 10
        && data.receipt_date.matches('^\\d{4}-\\d{2}-\\d{2}$')
        && data.currency is string
        && data.currency.size() == 3
        && data.currency.matches('^[A-Z]{3}$')
        && data.subtotal is number
        && data.gst_amount is number
        && data.total_amount is number
        && data.category is string
        && data.category.size() >= 1
        && data.category.size() <= 60
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    match /users/{userId} {
      allow get: if isValidId(userId) && isOwner(userId);
      allow list: if false;
      allow create: if isValidId(userId)
        && isOwner(userId)
        && isValidUserVaultProfile(incoming(), userId)
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isValidId(userId)
        && isOwner(userId)
        && isValidUserVaultProfile(incoming(), userId)
        && incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'updatedAt'])
        && incoming().uid == existing().uid
        && incoming().email == existing().email
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time;
      allow delete: if isValidId(userId) && isOwner(userId);
    }

    match /receipts/{receiptId} {
      allow get: if isValidId(receiptId)
        && isVerifiedUser()
        && existing().userId == request.auth.uid;
      allow list: if isVerifiedUser()
        && resource.data.userId == request.auth.uid;
      allow create: if isValidId(receiptId)
        && isVerifiedUser()
        && isValidReceipt(incoming(), receiptId)
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isValidId(receiptId)
        && isVerifiedUser()
        && existing().userId == request.auth.uid
        && isValidReceipt(incoming(), receiptId)
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'merchant_name', 'receipt_date', 'currency',
          'subtotal', 'gst_amount', 'total_amount',
          'category', 'updatedAt'
        ])
        && incoming().id == existing().id
        && incoming().userId == existing().userId
        && incoming().sha256Hash == existing().sha256Hash
        && incoming().uploadedAtUtc == existing().uploadedAtUtc
        && incoming().fileName == existing().fileName
        && incoming().fileSizeBytes == existing().fileSizeBytes
        && incoming().mimeType == existing().mimeType
        && incoming().imageUrl == existing().imageUrl
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time;
      allow delete: if isValidId(receiptId)
        && isVerifiedUser()
        && existing().userId == request.auth.uid;
    }
  }
}
